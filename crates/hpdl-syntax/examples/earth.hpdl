// An Earth-like planet with declared physical properties and traits.
// Native HPDL grammar v1.0 (ratified — see GRAMMAR.md / ADR 0010).
language hpdl "1.0";

planet terra_nova {
    id: "terra-nova",
    physical: {
        mass_kg: 5972000000000000000000000,
        radius_m: 6371000,
        surface_gravity_mms2: 9810,
        orbital_period_s: 31557600,
        rotation_period_s: 86164,
    },
    traits: {
        tags: ["terrestrial", "habitable-zone"],
    },
}
